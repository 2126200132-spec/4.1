<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="500.0" prefWidth="750.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="edu.utj.dsm.poo.gym.controlador.ClienteController">
   <children>
      <VBox spacing="10.0" AnchorPane.bottomAnchor="15.0" AnchorPane.leftAnchor="20.0" AnchorPane.rightAnchor="20.0" AnchorPane.topAnchor="15.0">
         <children>
            <!-- Encabezado de Sesión y Cierre -->
            <HBox alignment="CENTER_LEFT" spacing="15.0">
               <children>
                  <Label fx:id="lblSesion" text="Usuario: Cliente" HBox.hgrow="ALWAYS">
                     <font>
                        <Font name="System Bold" size="13.0" />
                     </font>
                  </Label>
                  <Button fx:id="btnCerrarSesion" onAction="#handleCerrarSesion" style="-fx-background-color: #d9534f; -fx-text-fill: white;" text="Cerrar Sesión" />
               </children>
            </HBox>

            <TableView fx:id="tblClientes" prefHeight="260.0" prefWidth="710.0">
              <columns>
                <TableColumn fx:id="colId" prefWidth="70.0" text="ID" />
                <TableColumn fx:id="colNombre" prefWidth="180.0" text="Nombre" />
                <TableColumn fx:id="colEmail" prefWidth="200.0" text="Correo Electrónico" />
                <TableColumn fx:id="colTelefono" prefWidth="130.0" text="Teléfono" />
                <TableColumn fx:id="colEstado" prefWidth="120.0" text="Estado" />
              </columns>
            </TableView>

            <HBox spacing="10.0">
               <children>
                  <TextField fx:id="txtId" prefWidth="70.0" promptText="ID" />
                  <TextField fx:id="txtNombre" prefWidth="180.0" promptText="Nombre" />
                  <TextField fx:id="txtEmail" prefWidth="200.0" promptText="Correo Electrónico" />
                  <TextField fx:id="txtTelefono" prefWidth="130.0" promptText="Teléfono" />
                  <ComboBox fx:id="cmbEstado" prefWidth="110.0" promptText="Estado" />
               </children>
            </HBox>

            <HBox spacing="10.0">
               <children>
                  <Label fx:id="lblErrorId" prefWidth="70.0" style="-fx-font-size: 9px;" text="" textFill="RED" wrapText="true" />
                  <Label fx:id="lblErrorNombre" prefWidth="180.0" style="-fx-font-size: 9px;" text="" textFill="RED" wrapText="true" />
                  <Label fx:id="lblErrorEmail" prefWidth="200.0" style="-fx-font-size: 9px;" text="" textFill="RED" wrapText="true" />
                  <Label fx:id="lblErrorTelefono" prefWidth="130.0" style="-fx-font-size: 9px;" text="" textFill="RED" wrapText="true" />
                  <Label fx:id="lblErrorEstado" prefWidth="110.0" style="-fx-font-size: 9px;" text="" textFill="RED" wrapText="true" />
               </children>
            </HBox>

            <HBox alignment="CENTER_RIGHT" spacing="8.0">
               <children>
                  <Button fx:id="btnNuevo" onAction="#handleNuevo" text="Nuevo" />
                  <Button fx:id="btnValidar" onAction="#handleValidar" text="Validar" />
                  <Button fx:id="btnGuardar" onAction="#handleGuardar" text="Guardar" />
                  <Button fx:id="btnEditar" onAction="#handleEditar" text="Editar" />
                  <Button fx:id="btnEliminar" onAction="#handleEliminar" text="Eliminar" />
                  <Button fx:id="btnLimpiar" onAction="#handleLimpiar" text="Limpiar" />
               </children>
            </HBox>
         </children>
      </VBox>
   </children>
</AnchorPane>