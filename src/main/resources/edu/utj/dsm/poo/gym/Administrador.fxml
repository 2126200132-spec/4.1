<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="550.0" prefWidth="750.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="edu.utj.dsm.poo.gym.controlador.AdministradorController">
   <children>
      <VBox alignment="TOP_CENTER" spacing="12.0" AnchorPane.bottomAnchor="20.0" AnchorPane.leftAnchor="20.0" AnchorPane.rightAnchor="20.0" AnchorPane.topAnchor="20.0">
         <children>
            <!-- Encabezado de Sesión y Cierre -->
            <HBox alignment="CENTER_LEFT" spacing="15.0">
               <children>
                  <Label fx:id="lblSesion" text="Usuario: Administrador" HBox.hgrow="ALWAYS">
                     <font>
                        <Font name="System Bold" size="13.0" />
                     </font>
                  </Label>
                  <Button fx:id="btnCerrarSesion" onAction="#handleCerrarSesion" style="-fx-background-color: #d9534f; -fx-text-fill: white;" text="Cerrar Sesión" />
               </children>
            </HBox>

            <TableView fx:id="tblAdministradores" prefHeight="280.0" prefWidth="710.0">
               <columns>
                  <TableColumn fx:id="colId" prefWidth="80.0" text="ID" />
                  <TableColumn fx:id="colNombre" prefWidth="170.0" text="Nombre Admin" />
                  <TableColumn fx:id="colEmail" prefWidth="200.0" text="Correo Electrónico" />
                  <TableColumn fx:id="colRol" prefWidth="130.0" text="Rol / Permiso" />
                  <TableColumn fx:id="colEstado" prefWidth="110.0" text="Estado" />
               </columns>
            </TableView>

            <VBox spacing="5.0">
               <children>
                  <HBox alignment="CENTER" spacing="10.0">
                     <children>
                        <TextField fx:id="txtId" prefWidth="70.0" promptText="ID" />
                        <TextField fx:id="txtNombre" prefWidth="150.0" promptText="Nombre Admin" />
                        <TextField fx:id="txtEmail" prefWidth="180.0" promptText="Correo Electrónico" />
                        <ComboBox fx:id="cmbRol" prefWidth="120.0" promptText="Rol" />
                        <ComboBox fx:id="cmbEstado" prefWidth="110.0" promptText="Estado" />
                     </children>
                  </HBox>

                  <HBox alignment="CENTER" spacing="10.0">
                     <children>
                        <Label fx:id="lblErrorId" prefWidth="70.0" textFill="RED" />
                        <Label fx:id="lblErrorNombre" prefWidth="150.0" textFill="RED" />
                        <Label fx:id="lblErrorEmail" prefWidth="180.0" textFill="RED" />
                        <Label fx:id="lblErrorRol" prefWidth="120.0" textFill="RED" />
                        <Label fx:id="lblErrorEstado" prefWidth="110.0" textFill="RED" />
                     </children>
                  </HBox>
               </children>
            </VBox>

            <HBox alignment="CENTER" spacing="10.0">
               <children>
                  <Button fx:id="btnNuevo" onAction="#handleNuevo" text="Nuevo" />
                  <Button fx:id="btnValidar" onAction="#handleValidar" text="Validar" />
                  <Button fx:id="btnGuardar" onAction="#handleGuardar" text="Guardar" />
                  <Button fx:id="btnEditar" onAction="#handleEditar" text="Editar" />
                  <Button fx:id="btnEliminar" onAction="#handleEliminar" text="Eliminar" />
                  <Button fx:id="btnLimpiar" onAction="#handleLimpiar" text="Limpiar" />
               </children>
            </HBox>
         </children>
      </VBox>
   </children>
</AnchorPane>