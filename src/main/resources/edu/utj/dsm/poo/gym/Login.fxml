<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="420.0" prefWidth="480.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="edu.utj.dsm.poo.gym.controlador.LoginController">
   <children>
      <VBox alignment="CENTER" spacing="15.0" AnchorPane.bottomAnchor="40.0" AnchorPane.leftAnchor="60.0" AnchorPane.rightAnchor="60.0" AnchorPane.topAnchor="40.0">
         <children>
            <Label text="SISTEMA GYM - LOGIN">
               <font>
                  <Font name="System Bold" size="22.0" />
               </font>
            </Label>
            
            <VBox spacing="5.0">
               <children>
                  <Label text="ID o Correo Electrónico:" />
                  <TextField fx:id="txtUsuario" promptText="ej. 1 o admin@gym.com" />
               </children>
            </VBox>
            
            <VBox spacing="5.0">
               <children>
                  <Label text="Contraseña:" />
                  <PasswordField fx:id="txtPassword" promptText="Ingresa tu contraseña" />
               </children>
            </VBox>

            <Label fx:id="lblError" textFill="RED" wrapText="true" />

            <Button fx:id="btnLogin" defaultButton="true" onAction="#handleLogin" prefHeight="35.0" prefWidth="180.0" text="Iniciar Sesión" />
         </children>
      </VBox>
   </children>
</AnchorPane>